<?xml version="1.0"?>
<ruleset name="TyBirill">
  <description>Standard de code du projet Ty Birill (PSR-12)</description>

  <!-- Code du projet : configuration Bedrock et thème sur mesure -->
  <file>config</file>
  <file>web/app/themes/themetybirill</file>

  <arg name="extensions" value="php"/>
  <exclude-pattern>*/dist/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>

  <arg value="-colors"/>
  <arg value="ns"/>

  <rule ref="PSR12">
    <!-- Les gabarits WordPress mêlent HTML et PHP -->
    <exclude name="PSR1.Files.SideEffects"/>
    <exclude name="PSR12.Files.FileHeader"/>
    <!-- WordPress charge le thème sans autoloader PSR-4 -->
    <exclude name="PSR1.Classes.ClassDeclaration.MissingNamespace"/>
  </rule>

  <!-- Gabarits : l'indentation suit le HTML, pas le PHP -->
  <rule ref="Generic.WhiteSpace.ScopeIndent">
    <exclude-pattern>web/app/themes/themetybirill/*.php</exclude-pattern>
    <exclude-pattern>web/app/themes/themetybirill/parts/*.php</exclude-pattern>
  </rule>
  <rule ref="Squiz.ControlStructures.ControlSignature">
    <exclude-pattern>web/app/themes/themetybirill/*.php</exclude-pattern>
  </rule>
  <rule ref="Generic.Files.LineLength">
    <properties>
      <property name="lineLimit" value="140"/>
    </properties>
  </rule>
</ruleset>
